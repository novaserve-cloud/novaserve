{
  "name": "novaserve-provider-kubernetes",
  "version": "2.2.0",
  "description": "NovaServe Kubernetes Provider — Generate and apply Kubernetes manifests",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.0.0",
    "novaserve-core": "workspace:*",
    "novaserve-sdk": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "Apache-2.0"
}
