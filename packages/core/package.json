{
  "name": "@novaserve/core",
  "version": "0.1.0",
  "description": "NovaServe Core Engine — config parsing, dependency graph, bundling, deployment",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@novaserve/sdk": "workspace:*",
    "esbuild": "^0.24.0",
    "chokidar": "^4.0.0",
    "glob": "^11.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": ["dist"],
  "license": "MIT"
}
