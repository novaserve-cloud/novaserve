{
  "name": "@novaserve/provider-local",
  "version": "0.1.0",
  "description": "NovaServe Local Provider — In-process dev server with hot reload",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@novaserve/core": "workspace:*",
    "@novaserve/sdk": "workspace:*",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "chokidar": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": ["dist"],
  "license": "MIT"
}
