{
  "name": "novaserve-provider-gcp",
  "version": "2.1.9",
  "description": "NovaServe GCP Provider — Deploy to Cloud Functions, Cloud Storage, Pub/Sub, Cloud Scheduler, Cloud SQL, Memorystore, API Gateway, and Secret Manager",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo",
    "test": "vitest run"
  },
  "dependencies": {
    "novaserve-core": "workspace:*",
    "novaserve-sdk": "workspace:*",
    "google-auth-library": "^11.0.0",
    "@google-cloud/functions": "^5.0.0",
    "@google-cloud/storage": "^8.0.0",
    "@google-cloud/pubsub": "^6.0.0",
    "@google-cloud/scheduler": "^6.0.0",
    "@google-cloud/redis": "^6.0.0",
    "@google-cloud/secret-manager": "^7.0.0",
    "@google-cloud/api-gateway": "^5.0.0",
    "@google-cloud/resource-manager": "^7.0.0",
    "@googleapis/sqladmin": "^38.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Md Shadab Azam Ansari",
    "email": "md.shadab.azam.ansari@gmail.com",
    "url": "https://www.novaserve.cloud/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaserve-cloud/novaserve.git"
  },
  "homepage": "https://www.novaserve.cloud/",
  "keywords": [
    "serverless",
    "framework",
    "cloud",
    "typescript",
    "iac",
    "novaserve"
  ]
}
