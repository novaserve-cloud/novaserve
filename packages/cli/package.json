{
  "name": "novaserve",
  "version": "2.1.5",
  "description": "NovaServe — Next-Generation Cloud-Agnostic Serverless Development Framework",
  "author": {
    "name": "Md Shadab Azam Ansari",
    "email": "md.shadab.azam.ansari@gmail.com",
    "url": "https://md-shadab-azam-ansari.vercel.app/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sazamansari/NovaServe-.git"
  },
  "homepage": "https://md-shadab-azam-ansari.vercel.app/",
  "keywords": [
    "serverless",
    "framework",
    "cloud",
    "typescript",
    "iac",
    "novaserve"
  ],
  "type": "module",
  "bin": {
    "nova": "dist/index.js",
    "novaserve": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js",
      "default": "./dist/runtime.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "novaserve-sdk": "workspace:*",
    "novaserve-core": "workspace:*",
    "novaserve-runtime": "workspace:*",
    "novaserve-provider-local": "workspace:*",
    "novaserve-provider-aws": "workspace:*",
    "novaserve-provider-azure": "workspace:*",
    "novaserve-provider-gcp": "workspace:*",
    "novaserve-provider-cloudflare": "workspace:*",
    "novaserve-provider-docker": "workspace:*",
    "commander": "^13.0.0",
    "chalk": "^5.4.0",
    "ora": "^8.0.0",
    "inquirer": "^12.0.0",
    "cli-table3": "^0.6.0",
    "boxen": "^8.0.0",
    "figures": "^6.0.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@types/inquirer": "^9.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
