{
  "name": "novaserve-provider-aws",
  "version": "2.2.0",
  "description": "NovaServe AWS Provider — Deploy to AWS Lambda, API Gateway, S3, SQS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "novaserve-core": "workspace:*",
    "novaserve-sdk": "workspace:*",
    "@aws-sdk/client-lambda": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-apigatewayv2": "^3.700.0",
    "@aws-sdk/client-sqs": "^3.700.0",
    "@aws-sdk/client-iam": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.700.0",
    "@aws-sdk/client-sts": "^3.700.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Md Shadab Azam Ansari",
    "email": "md.shadab.azam.ansari@gmail.com",
    "url": "https://www.novaserve.cloud/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaserve-cloud/novaserve.git"
  },
  "homepage": "https://www.novaserve.cloud/",
  "keywords": [
    "serverless",
    "framework",
    "cloud",
    "typescript",
    "iac",
    "novaserve"
  ]
}
