{
  "name": "novaserve-provider-azure",
  "version": "2.2.0",
  "description": "NovaServe Azure Provider — Deploy to Azure Functions, Blob Storage, Service Bus, Cosmos DB, Key Vault, Redis Cache, Event Grid, and Timer Triggers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "novaserve-core": "workspace:*",
    "novaserve-sdk": "workspace:*",
    "@azure/identity": "^4.5.0",
    "@azure/arm-resources": "^5.2.0",
    "@azure/arm-appservice": "^19.0.0",
    "@azure/arm-storage": "^18.2.0",
    "@azure/storage-blob": "^12.26.0",
    "@azure/arm-servicebus": "^6.1.0",
    "@azure/storage-queue": "^12.25.0",
    "@azure/arm-apimanagement": "^9.2.0",
    "@azure/arm-cosmosdb": "^16.0.0",
    "@azure/arm-authorization": "^9.0.0",
    "@azure/arm-monitor": "^7.0.0",
    "@azure/arm-keyvault": "^3.1.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@azure/arm-rediscache": "^8.1.0",
    "@azure/arm-eventgrid": "^14.2.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Md Shadab Azam Ansari",
    "email": "md.shadab.azam.ansari@gmail.com",
    "url": "https://www.novaserve.cloud/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaserve-cloud/novaserve.git"
  },
  "homepage": "https://www.novaserve.cloud/",
  "keywords": [
    "serverless",
    "framework",
    "cloud",
    "typescript",
    "iac",
    "novaserve",
    "azure",
    "azure-functions",
    "keyvault",
    "redis",
    "eventgrid"
  ]
}
